#!/usr/bin/env bash
# Start the local trace viewer from any working directory.
# Global options such as --data-root must precede the subcommand:
#   ./traces --data-root /path/to/data --port 8765
set -euo pipefail

HARNESS_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if command -v uv >/dev/null 2>&1; then
    UV_BIN="$(command -v uv)"
elif [[ -x "$HOME/.local/bin/uv" ]]; then
    UV_BIN="$HOME/.local/bin/uv"
else
    echo "UV was not found. Install UV or add it to PATH before starting traces." >&2
    exit 127
fi

# Parse global options before the subcommand; forward everything else.
global_args=()
rest=()
while (($#)); do
    case "$1" in
        --data-root)
            if (($# < 2)) || [[ "$2" == --* ]]; then
                echo "traces: --data-root requires a PATH value" >&2
                exit 2
            fi
            global_args+=("--data-root" "$2")
            shift 2
            ;;
        --data-root=*)
            global_args+=("$1")
            shift
            ;;
        --)
            rest+=("$@")
            break
            ;;
        *)
            rest+=("$1")
            shift
            ;;
    esac
done

cd -- "$HARNESS_DIR"
exec "$UV_BIN" run --locked local-agent "${global_args[@]+"${global_args[@]}"}" trace-web "${rest[@]+"${rest[@]}"}"
